# Deal Hunter — Server Environment
# Copy to .env and fill in values

# Required on the server — GHCR image tag (e.g. sha-abc123 or v1.0.0).
# Do not use "latest" in production; pin the tag deployed by CI.
DEAL_HUNTER_IMAGE_TAG=

# Optional image repository override (default: ghcr.io/laraib-sidd/deal-hunter)
# DEAL_HUNTER_IMAGE=ghcr.io/laraib-sidd/deal-hunter

# Dashboard binds to loopback only (127.0.0.1:8001). Reach it via SSH tunnel
# or a reverse proxy on the host — it is not exposed on the public interface.

# Groq (free, https://console.groq.com)
DEAL_HUNTER_GROQ_API_KEY=

# Reddit (https://reddit.com/prefs/apps)
DEAL_HUNTER_REDDIT_CLIENT_ID=
DEAL_HUNTER_REDDIT_CLIENT_SECRET=

# Telegram alerts
DEAL_HUNTER_TELEGRAM__ENABLED=true
DEAL_HUNTER_TELEGRAM__BOT_TOKEN=
DEAL_HUNTER_TELEGRAM__CHAT_ID=

# SQLite path (mounted volume)
DEAL_HUNTER_DB_PATH=/data/deals.db
