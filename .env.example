# Deal Hunter — API Keys & Config
# Get your free Groq key at https://console.groq.com (no credit card)
DEAL_HUNTER_GROQ_API_KEY=

# Reddit (optional) — register at https://reddit.com/prefs/apps
DEAL_HUNTER_REDDIT_CLIENT_ID=
DEAL_HUNTER_REDDIT_CLIENT_SECRET=

# Telegram alerts (optional)
DEAL_HUNTER_TELEGRAM__ENABLED=false
DEAL_HUNTER_TELEGRAM__BOT_TOKEN=
DEAL_HUNTER_TELEGRAM__CHAT_ID=

# --- Scraper behaviour (optional; defaults shown) ---
# DEAL_HUNTER_REDDIT_LIMIT=200            # posts per subreddit batch
# DEAL_HUNTER_TECHENCLAVE_REQUEST_DELAY=1.5
# DEAL_HUNTER_TECHENCLAVE_TIMEOUT=20.0
# DEAL_HUNTER_TECHENCLAVE_DEADLINE_SECONDS=120.0
# DEAL_HUNTER_HTTP_TIMEOUT=15.0
# DEAL_HUNTER_HTTP_MAX_RETRIES=3
# DEAL_HUNTER_NETSKOPE_CA_PATH=/private/etc/netskope/netskope-cert-bundle.pem

# --- AI (optional; defaults shown) ---
# DEAL_HUNTER_AI_MODEL=meta-llama/llama-4-scout-17b-16e-instruct